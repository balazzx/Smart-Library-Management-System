SECRET_KEY=your-very-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_APP=run.py

# ─── Database Configuration ───────────────────────────────────────────────────
# Option 1: MySQL (recommended for production)
# Fill in your MySQL credentials. If connection fails, app auto-falls back to SQLite.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smart_library_db

# Option 2: SQLite (default / fallback)
# If MySQL is not configured or unreachable, the app uses smart_library.db automatically.
# No extra config needed.

# ─── Email / SMTP Configuration ───────────────────────────────────────────────
# Used for sending due-date reminders and fine notifications
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_library_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
# Note: Use a Gmail App Password (not your login password).
# Go to: Google Account → Security → 2-Step Verification → App Passwords
